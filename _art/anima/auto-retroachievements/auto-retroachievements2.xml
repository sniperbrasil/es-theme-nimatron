<theme>
	<formatVersion>7</formatVersion>

	<view name="system">

		<!-- AVATARS -->
		<image name="avatar" extra="true">
         <pos>0.370 0.210</pos>
         <maxSize>0.32 0.56</maxSize>
         <path>./avatar.png</path>
		 <zIndex>270</zIndex>
		 
      <storyboard repeat="forever">
        <animation property="y" from="0.05" begin="-1" duration="350" mode="easeOut"/>
        <animation property="opacity" from="0" to="1" duration="2950" mode="easeIn"/>
        <animation property="scale" from="0" to="1" duration="350" mode="easeOut"/>
		<animation property="scale" to="1.2" begin="350" autoreverse="true" duration="3200" mode="easyIn"/>
		<animation property="opacity" begin="5000" to="0" duration="2950"/>
		
		
      </storyboard>		 
		 


	
</image>
		
	</view>
</theme>
