<!-- Auto Retro Achievements -->

<theme>
	<formatVersion>7</formatVersion>

	<view name="system">
	
		<image name="avatar" extra="static">
			<origin>0 0</origin>									
			<size>0.27 0.48</size>									
			<pos>0.4 -1</pos>
			<scale>0.3</scale>
			<rotation>2</rotation>
			<zIndex>3</zIndex>
			<opacity>1</opacity>
			<path>./avatar.png</path>
		
			<storyboard>
				<animation property="scale" from="0.3" to="0.93" begin="100" duration="1000" mode="bump"/>
				<animation property="y" from="-1" to="0.37" begin="400" duration="1000" mode="EaseIn"/>
				<animation property="y" to="0.37" begin="1400" duration="500" mode="bump"/>
				<animation property="rotation" from="1" to="-1" begin="1400" autoreverse="true" duration="4000" repeat="forever" mode="linear"/>
				<animation property="scale" from="0.93" to="0.97" begin="1400" autoreverse="true" duration="4000" repeat="forever" mode="linear"/>
				<animation property="y" from="0.37" to="0.30" begin="1400" autoreverse="true" duration="4000" repeat="forever" mode="easeOut"/>
				
			</storyboard>			
		</image>
		
		<!-- papel de parede -->
<image name="wp_master" extra="true">
		 <origin>0.5 0.5</origin>
		 <pos>0.590 0.385</pos>
         <size>0.7900 0.7530</size>
		 <delay>0</delay>
		 <path>./../../background/${system.theme}.jpg</path>
	 <zIndex>2</zIndex>
	 <storyboard>
<animation property="scale" from="1.3" to="0.98" begin="0" duration="600" mode="linear"/>
</storyboard>
</image>
		
		
		
		
		
		
		
	</view>

</theme>
