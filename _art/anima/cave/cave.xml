<!-- advision Adventure Vision -->

<theme>
	<formatVersion>7</formatVersion>

	<view name="system">
	
		<image name="nave, nave2" extra="true">
			<origin>0.5 0.5</origin>	
			<linearSmooth>true</linearSmooth>
		</image>
		

		
		<image name="nave" extra="true">
			<pos>0 0</pos>									
			<size>0.359375 0.7944444</size>									
			<path>./nave.gif</path>
			<zIndex>3</zIndex>
			<flipX>true</flipX>
			<scale>0.35</scale>
			<storyboard repeat="forever">
					<animation property="x" to="1" begin="0" duration="6000" mode="linear"/>
					<animation property="y" to="1" begin="0" duration="8000" mode="linear"/>
					
			</storyboard>
		</image>
		
		<image name="nave2" extra="true">
			<pos>1 0</pos>									
			<size>0.359 0.794</size>									
			<path>./nave.gif</path>
			<zIndex>3</zIndex>
			<flipX>false</flipX>
			<scale>0.38</scale>
			<storyboard repeat="forever">
					<animation property="x" to="-1" begin="6000" duration="6000" mode="linear"/>
					<animation property="y" to="1" begin="6000" duration="6000" mode="linear"/>
					
			</storyboard>
		</image>
		
		
		
		
		
		
	</view>

</theme>
