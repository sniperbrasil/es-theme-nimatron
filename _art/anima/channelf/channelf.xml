<theme>
	<formatVersion>7</formatVersion>

	<view name="system">

		<image name="avatar, avatar_ghost1, avatar_ghost2, avatar2, avatar3, avatar4" extra="static">
			<origin>0 0</origin> <!-- Left -->
			<pos>0.2823 0.047</pos>
			<maxSize>0.52 0.9067</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>3</zIndex>
		</image>
		
		<!-- Sytem LOGO zIndex = 15 -->
		
		<image name="avatar2" extra="static">
		    <pos>0.500 0.500</pos>
			<maxSize>0.52 0.350</maxSize>
			<path>./avatar-pion.png</path>
			<zIndex>15</zIndex>
			<storyboard>
				<animation property="x" from="-2" begin="0" duration="1550" mode="linear"/>
				<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
			</storyboard>
		</image>
		<image name="avatar3" extra="static">
		    <pos>0.200 0.055</pos>
			<maxSize>0.52 0.600</maxSize>
			<path>./avatar-reine.png</path>
			<zIndex>3</zIndex>
			<storyboard>
				<animation property="x" from="2" begin="0" duration="750" mode="linear"/>
				<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
			</storyboard>
		</image>

		<!-- Shadow fade Animation -->
		<image name="avatar4" extra="static">
			<path>./avatar-shadow.png</path>
			<zIndex>13</zIndex>
			<opacity>0</opacity>
			<storyboard>
				<animation property="opacity" from="0" to="0.5" begin="650" duration="1000" mode="linear"/>
			</storyboard>
		</image>

<!-- papel de parede -->
<image name="wp_master" extra="true">
		 <origin>0.5 0.5</origin>
		 <pos>0.590 0.385</pos>
         <size>0.7900 0.7530</size>
		 <delay>0</delay>
		 <path>./../../background/${system.theme}.jpg</path>
	 <zIndex>2</zIndex>
	 <storyboard>
<animation property="scale" from="1.3" to="0.98" begin="0" duration="600" mode="linear"/>
</storyboard>
</image>

	</view>

	<!-- Black King Animation -->
	<include>./../_art/storyboards/ghost.xml</include>

</theme>

