<theme>
	<formatVersion>7</formatVersion>

	<view name="system">

		<image name="avatar, avatar2" extra="static">
		<path>./avatar.png</path>
			<origin>0 0</origin>
			<pos>0.450 0.250</pos>
			<maxSize>0.420 0.520</maxSize>
			<linearSmooth>true</linearSmooth>
			<zIndex>3</zIndex>
		
			<storyboard>
        		<animation property="scale"    to="1.02" begin="0"   autoreverse="true" duration="500" repeat="forever" mode="easyIn"/>
        		<animation property="rotation" to="1.02" begin="150" autoreverse="true" duration="500" repeat="forever" mode="easyIn"/>

        		<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
			</storyboard>
		</image>
		
		<!-- papel de parede -->
<image name="wp_master" extra="true">
		 <origin>0.5 0.5</origin>
		 <pos>0.590 0.385</pos>
         <size>0.7900 0.7530</size>
		 <delay>0</delay>
		 <path>./../../background/${system.theme}.jpg</path>
	 <zIndex>2</zIndex>
	 <storyboard>
<animation property="scale" from="1.3" to="0.98" begin="0" duration="600" mode="linear"/>
</storyboard>
</image>
		
	</view>

</theme>

