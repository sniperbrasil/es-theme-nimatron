<theme>
	<formatVersion>7</formatVersion>

	<view name="system">

		
		<image name="avatar4, avatar5" extra="static">
			<origin>0 0</origin>
			<linearSmooth>true</linearSmooth>
			<zIndex>3</zIndex>
		</image>
		<image name="avatar4" extra="static">
			<pos>0.196 0.200</pos>
			<size>0.240 0.600</size>
			<path>./pri.png</path>
			<storyboard repeatAt="350">
        		<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
				<animation property="x" from="-1" begin="0" duration="350" mode="easyOut"/>
				<animation property="origin" to="-0.9 0" begin="100" duration="7000" autoreverse="true" mode="linear"/>
			</storyboard>
		</image>
		<image name="avatar5" extra="static">
			<pos>0.374 0.200</pos>
			<size>0.200 0.600</size>
			<path>./sec.png</path>
			<color>ffffff</color>
			<storyboard repeatAt="350">
        		<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
				<animation property="x" from="1" begin="0" duration="350" mode="easyOut"/>
				<animation property="origin" to="0.6 0" begin="100" duration="7000" autoreverse="true" mode="linear"/>
			</storyboard>
		</image>
		
		<!-- papel de parede -->
<image name="wp_master" extra="true">
		 <origin>0.5 0.5</origin>
		 <pos>0.590 0.385</pos>
         <size>0.7900 0.7530</size>
		 <delay>0</delay>
		 <path>./../../background/${system.theme}.jpg</path>
	 <zIndex>2</zIndex>
	 <storyboard>
<animation property="scale" from="1.3" to="0.98" begin="0" duration="600" mode="linear"/>
</storyboard>
</image>
		
	</view>
</theme>

<maxSize>0.10 0.625</maxSize>
