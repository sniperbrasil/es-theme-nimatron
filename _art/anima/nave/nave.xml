<theme>
   <formatVersion>7</formatVersion>

<view name="system">
<!-- origem e zIndex das imagens -->
<image name="jet01" extra="true" ifSubset="system background:Back personagens">							back
	<path>./config/AP_group_sys-back/personagens/JetF/JF0.jpg</path>
	<zIndex>999</zIndex>
</image>
<image name="jet02" extra="true">																		F22 pose
	<path>./JF3.png</path>
	<zIndex>999</zIndex>
</image>

<!-- posicionameto, tamanho, escala, cor e outros das imagens -->
<image name="jet01">																					back
	<color>ffffff</color>
	<flipX>true</flipX>
	<origin>0.5 0.5</origin>
	<pos>0.5 0.5</pos>
	<size>1 1</size>
	<opacity>1</opacity>
	<zIndex>999</zIndex>
</image>
<image name="jet02">																					POSE
	<flipX>false</flipX>
	<origin>0.5 0.5</origin>
	<pos>0.40 0.27</pos>
	<maxSize>0.45 0.45</maxSize>
	<opacity>0</opacity>
	<scale>0</scale>
	<scaleOrigin>0 0</scaleOrigin>
	<zIndex>999</zIndex>
</image>

<!-- efeitos das imagens --> 
<image name="jet02">																					pose F22
    <zIndex>999</zIndex>
	<storyboard repeat="forever">
			trajetória
		<animation property="scale" from="0" to="0.6" begin="0" duration="2000" mode="Linear" autoReverse="false"/>
			visibilidade
		<animation property="opacity" from="0" to="1" begin="0" duration="100" mode="Linear"/>
		<animation property="opacity" from="1" to="1" begin="100" duration="1900" mode="Linear"/>
		<animation property="opacity" from="1" to="1" begin="2000" duration="14750" mode="Linear"/>
		<animation property="opacity" from="1" to="1" begin="16750" duration="1100" mode="Linear"/>
			estabilidade
		<animation property="offsetX" from="0" to="-0.01" begin="2000" duration="4000" mode="Linear" autoReverse="false"/>
		<animation property="offsetY" from="0" to="-0.01" begin="2000" duration="4000" mode="Linear" autoReverse="false"/>
		<animation property="offsetX" from="-0.01" to="-0.01" begin="6000" duration="4000" mode="Linear" autoReverse="false"/>
		<animation property="offsetY" from="-0.01" to="0" begin="6000" duration="4000" mode="Linear" autoReverse="false"/>			
		<animation property="offsetX" from="-0.01" to="0.01" begin="10000" duration="4000" mode="Linear" autoReverse="false"/>
		<animation property="offsetY" from="0" to="0.01" begin="10000" duration="4000" mode="Linear" autoReverse="false"/>			
		<animation property="offsetX" from="0.01" to="0.01" begin="14000" duration="2000" mode="Linear" autoReverse="false"/>
		<animation property="offsetY" from="0.01" to="0" begin="14000" duration="2000" mode="Linear" autoReverse="false"/>
		<animation property="offsetX" from="0.01" to="-0.01" begin="16000" duration="2000" mode="Linear" autoReverse="false"/>
		<animation property="offsetY" from="0" to="0.01" begin="16000" duration="2000" mode="Linear" autoReverse="false"/>
		
		<animation property="offsetX" from="0" to="-0.015" begin="19000" duration="1000" mode="Linear" autoReverse="false"/>
		<animation property="offsetY" from="0" to="-0.015" begin="19000" duration="1000" mode="Linear" autoReverse="false"/>
			rotação estabilidade
		<animation property="rotation" from="-9" to="-9" begin="0" duration="2000" mode="Linear" autoReverse="false"/>
		<animation property="rotation" from="-9" to="-5" begin="2000" duration="4000" mode="Linear" autoReverse="false"/>			
		<animation property="rotation" from="-5" to="-12" begin="6000" duration="4000" mode="Linear" autoReverse="false"/>
		<animation property="rotation" from="-12" to="-5" begin="10000" duration="2000" mode="Linear" autoReverse="false"/>
		<animation property="rotation" from="-5" to="-12" begin="12000" duration="2000" mode="Linear" autoReverse="false"/>
		<animation property="rotation" from="-12" to="2" begin="14000" duration="2000" mode="Linear" autoReverse="false"/>
		<animation property="rotation" from="2" to="30" begin="16000" duration="750" mode="Linear" autoReverse="false"/>
		<animation property="rotation" from="30" to="30" begin="16750" duration="250" mode="Linear" autoReverse="false"/>
		<animation property="rotation" from="30" to="-10" begin="17000" duration="1000" mode="Linear" autoReverse="false"/>
			deslocação
		<animation property="x" from="0.40" to="0.55" begin="0" duration="17000" mode="Linear"/>
		<animation property="y" from="0.0" to="0.4" begin="0" duration="2000" mode="Linear"/>
		<animation property="y" from="0.4" to="0.4" begin="2000" duration="15000" mode="Linear"/>
		<animation property="x" from="0.55" to="1.30" begin="17000" duration="2000" mode="Linear"/>
		<animation property="y" from="0.4" to="1" begin="17000" duration="2000" mode="Linear"/>
		
			reboot
		<animation property="zIndex" from="999" to="" duration="20000" begin="" />
	</storyboard> 
</image>

</view>

</theme>