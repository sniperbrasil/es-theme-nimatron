<theme>
	<formatVersion>7</formatVersion>

	<view name="system">

		
		
		
		
		<!-- SMOKE -->
		<image name="avatar4, avatar5" extra="static">
			<origin>0 0</origin>
			<size>0.40 0.32</size>
			<path>./avatar.png</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>17</zIndex>
		</image>
		<image name="avatar4" extra="static">
			<pos>0.026 0.4</pos>
			<zIndex>3</zIndex>
			<path>./avatar.png</path>
			<storyboard repeatAt="350">
        		<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
				<animation property="x" from="-1" begin="0" duration="350" mode="easyOut"/>
				<animation property="origin" to="-0.3 0" begin="100" duration="10000" autoreverse="true" mode="linear"/>
			</storyboard>
		</image>
		<image name="avatar5" extra="static">
			<pos>0.304 0.4</pos>
			<zIndex>3</zIndex>
			<path>./avatar.png</path>
			<color>ffffff</color>
			<storyboard repeatAt="350">
        		<animation property="opacity" from="0" to="1" duration="350" mode="linear"/>
				<animation property="x" from="1" begin="0" duration="350" mode="easyOut"/>
				<animation property="origin" to="0.2 0" begin="100" duration="10000" autoreverse="true" mode="linear"/>
			</storyboard>
		</image>
		
		<!-- papel de parede -->
<image name="wp_master" extra="true">
		 <origin>0.5 0.5</origin>
		 <pos>0.590 0.385</pos>
         <size>0.7900 0.7530</size>
		 <delay>0</delay>
		 <path>./../../background/${system.theme}.jpg</path>
	 <zIndex>2</zIndex>
	 <storyboard>
<animation property="scale" from="1.3" to="0.98" begin="0" duration="600" mode="linear"/>
</storyboard>
</image>
		
	</view>
</theme>
