<theme>
	<formatVersion>7</formatVersion>

	<view name="system">

		<!-- NEVE DIREITA-->
		<image name="avatar1" extra="static">
			<origin>0 -0</origin>
			<pos>0.40 -0.999</pos>
			<maxSize>1.20 1.20</maxSize>
			<zIndex>2</zIndex>
			<path>./neve.png</path>
			<storyboard repeatAt="999"> 
            <animation property="y" from="-0.999" to="0.999" begin="1" duration="19500" mode="linear"/>
         </storyboard>
		</image>
				
		<image name="avatar2" extra="static">
			<origin>0 -0</origin>
			<pos>0.40 -0.999</pos>
			<maxSize>1.20 1.20</maxSize>
			<path>./neve.png</path>
			<storyboard repeatAt="999"> 
            <animation property="y" from="-0.999" to="0.999" begin="5000" duration="21500" mode="linear"/>
         </storyboard>
		</image>

		<!--NEVE ESQUERDA--> 
		<image name="avatar3" extra="static">
			<origin>0 -0</origin>
			<pos>0.05 -0.999</pos>
			<maxSize>1.20 1.20</maxSize>
			<path>./neve.png</path>
			<storyboard repeatAt="999"> 
        	<animation property="y" from="-0.999" to="0.999" begin="0" duration="19500" mode="linear"/>
         </storyboard>
		</image>
		
		<image name="avatar4" extra="static">
			<origin>0 -0</origin>
