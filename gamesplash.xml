<?xml version="1.0" encoding="UTF-8"?>
<theme>
<formatVersion>7</formatVersion>
	<view name="splash">
		
		<image name="backgroundalt" extra="true">
	    	<path>./_art/load.jpg</path>
			<linearSmooth>true</linearSmooth>
			<minSize>1 1</minSize>
			<zIndex>1</zIndex>
		</image>
		
		
		<text name="loading" extra="true">
			<origin>0 0</origin>
			<pos>0.390 0.735</pos>
			<alignment>left</alignment>
			<color>ffff00</color>
			<fontPath>./_art/font/arcade_light.ttf</fontPath>
			<fontSize>0.06</fontSize>
			<glowColor>09090920</glowColor>
			<glowSize>1</glowSize>
			<glowOffset>1</glowOffset>
			<text>LOADING...</text>
			<text lang="pt">CARREGANDO...</text>
			<text lang="fr">CHARGEMENT...</text>
			<text lang="es">CARGANDO...</text>
			<text lang="de">WIRD GELADEN...</text>
			<zIndex>8</zIndex>
		</text>

		<text name="label">
			<origin>0 0.5</origin>
			<pos>0 0.88</pos>
			<alignment>center</alignment>
			<color>ffff00</color>
			<fontPath>./main/fonts/XboxOriginalBold-YzPYy.otf</fontPath>
			<fontSize>0.082</fontSize>
			<glowColor>09090920</glowColor>
			<glowSize>1</glowSize>
			<glowOffset>1</glowOffset>
		</text>

       		<image name="hotkey-tips" extra="true">
			<color>208b20</color>
			<origin>1 0.5</origin>
			<pos>1 0.443</pos>
			<maxSize>0.35</maxSize>
			<maxSize tinyScreen="true">0.45</maxSize>			
			<path>./main/hotkey-tips/en.png</path>
			<path>./main/hotkey-tips/${lang}.png</path>
			<linearSmooth>true</linearSmooth>
			<zIndex>7</zIndex>
		</image>
		
		<image name="logo_do_publicador" extra="true">
		<path>./_art/logo/{game:publisher}.png</path>
		<origin>0.5 0.5</origin>
		<pos>0.190 0.500</pos>
		<!--size>0.200 0.210</size-->
		<maxSize>0.250 0.220</maxSize>	
		<zIndex>96</zIndex>
	    </image>
		
			
	<image name="arte" extra="true">
		<path>./_art/logo/{system:theme}.png</path>
		<origin>0.5 0.5</origin>
		<pos>0.190 0.200</pos>
		<!--size>0.200 0.210</size-->
		<maxSize>0.350 0.300</maxSize>	
		<zIndex>96</zIndex>
	</image>
	
	<image name="fanart_splash" extra="true">
		<path>{game:fanart}</path>
		<pos>0.45 0.10</pos>
		<origin>0 0</origin>
		<minSize>0.5 0.5</minSize>	
		<zIndex>96</zIndex>
	    </image>
		
		<!--  Painel de fundo do FANART  -->
<image name="back_FAN" extra="true">
     <path>./_art/ffgg.png</path>  
     <pos>0.44 0.06</pos>
	 <origin>0 0</origin>
     <size>0.52 0.58</size>
	 <opacity>1</opacity>
     <zIndex>98</zIndex>
     <color>ffff00</color>
</image>


		
<image name="background">
			<pos>0.45 0.10</pos>
			<origin>0 0</origin>
			<minSize>0.5 0.5</minSize>
			<roundCorners>3</roundCorners>
			<linearSmooth>true</linearSmooth>
			<color>ffffff</color>
			<colorEnd>404040</colorEnd>
			<gradientType>vertical</gradientType>
			<zIndex>95</zIndex>
		</image>			 
      

		<splash name="splash">
			<backgroundColor>000000FF</backgroundColor>
		</splash>

	</view>

</theme>
