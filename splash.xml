<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <formatVersion>7</formatVersion>
  
  <view name="splash">
    <splash name="splash">
      <backgroundColor>000000FF</backgroundColor>
    </splash>
    <image name="progressbar">
      <origin>0 0</origin>
      <pos>0.25 0.92</pos>
      <size>0.5 0.030</size>
      <color>6060607F</color>
      <colorEnd>6060607F</colorEnd>
      <roundCorners>0.01</roundCorners>
    </image>
    <image name="progressbar:active">
      <tile>true</tile>
      <path>./_art/progress.png</path>
      <color>0000ff</color>
      <colorEnd>000fff</colorEnd>
    </image>
    	
	
	<image name="logo_ES" extra="static">
			<origin>0.5 0.5</origin>
			<pos>0.900 0.520</pos>
			<maxSize>0.200 0.200</maxSize>
			<backgroundColor>ff000000</backgroundColor>
			<linearSmooth>true</linearSmooth>
			<zIndex>10</zIndex>
		    <path>./_art/logo_ES.png</path>
	</image>
	
	<image name="logo_rb" extra="static">
			<origin>0.5 0.5</origin>
			<pos>0.900 0.150</pos>
			<maxSize>0.200 0.200</maxSize>
			<backgroundColor>ff000000</backgroundColor>
			<linearSmooth>true</linearSmooth>
			<zIndex>10</zIndex>
		    <path>./_art/logo_rb.png</path>
	</image>
	
	<image name="logo_bat" extra="static">
			<origin>0.5 0.5</origin>
			<pos>0.900 0.320</pos>
			<maxSize>0.200 0.200</maxSize>
			<backgroundColor>ff000000</backgroundColor>
			<linearSmooth>true</linearSmooth>
			<zIndex>10</zIndex>
		    <path>./_art/batocera_logo.png</path>
	</image>
	
    <text name="label">
      <color>000000</color>
      <glowColor>ffff00</glowColor>
      <glowSize>2</glowSize>
      <glowOffset>0</glowOffset>
    </text>
	
	<image name="background" extra="true">
			<path>./_art/inicial.jpg</path>
			<zIndex>1</zIndex>
		</image>
    
  </view>
</theme>
